<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SubBill</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="alternate icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <meta name="theme-color" content="#14161F" />
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-header" style="text-align: center;">
                <a href="/" title="SubBill Home">
                    <img src="~/images/logo.svg" alt="SubBill Logo" style="height: 64px; width: auto; display: block; margin: 0 auto 1rem;" asp-append-version="true" />
                </a>
            </div>
            @RenderBody()
        </div>
    </div>
</body>
</html>
